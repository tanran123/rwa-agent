{
  "mode": "inline",
  "note": "【模拟数据】按《权重法风险暴露分类 JSON 怎么写》语法编写的内地演示规则集，权重与条款均为虚构值。",
  "resolves_to": {
    "id": "cn_sa_exposure_class",
    "label": "内地 · 信用风险权重法风险暴露分类",
    "jurisdiction": "CN",
    "jurisdiction_label": "内地",
    "version": "CN-SA-2026.1",
    "effective_from": "2026-01-01",
    "effective_to": null,
    "status": "published",
    "regulation": "【模拟】商业银行资本管理办法（演示用）",
    "description": "自上而下，第一条命中就停，再走进它的 children。这一层都不中时走 otherwise。字段没有填时，引用它的条件不命中。",
    "order": "first-match",
    "order_note": "数组顺序参与语义，禁止重排",
    "fields": [
      {
        "name": "instrument_type",
        "label": "工具",
        "type": "enum",
        "source": "column",
        "meaning": "这笔资产是什么形态。股权、资产担保债券、普通债权、现金四选一。表内贷款、债券、存放同业都填 claim。",
        "options": [
          {
            "label": "现金",
            "code": "cash"
          },
          {
            "label": "股权",
            "code": "equity"
          },
          {
            "label": "资产担保债券",
            "code": "covered_bond"
          },
          {
            "label": "债权",
            "code": "claim"
          }
        ]
      },
      {
        "name": "is_defaulted",
        "label": "是否已违约",
        "type": "enum",
        "source": "calc",
        "meaning": "逾期超过 90 天，或不处置押品就可能无法全额偿还。自然人按这一笔填，其他按这个债务人填。由逾期天数和五级分类推导。",
        "options": [
          {
            "label": "是",
            "code": "yes"
          },
          {
            "label": "否",
            "code": "no"
          }
        ]
      },
      {
        "name": "counterparty_type",
        "label": "交易对手",
        "type": "enum",
        "source": "column",
        "meaning": "债务人的主体性质。特殊主体、金融机构、公司、个人都看这个字段。客户类型为 P 多为自然人，C 为公司，B 为银行同业。",
        "options": [
          {
            "label": "我国中央政府",
            "code": "cn_central_government"
          },
          {
            "label": "我国中央银行",
            "code": "cn_central_bank"
          },
          {
            "label": "其他主权国家或经济实体",
            "code": "foreign_sovereign"
          },
          {
            "label": "公共部门实体",
            "code": "pse"
          },
          {
            "label": "多边开发银行",
            "code": "mdb"
          },
          {
            "label": "商业银行",
            "code": "commercial_bank"
          },
          {
            "label": "其他金融机构",
            "code": "other_fi"
          },
          {
            "label": "开发性金融机构",
            "code": "development_fi"
          },
          {
            "label": "政策性银行",
            "code": "policy_bank"
          },
          {
            "label": "公司",
            "code": "corporate"
          },
          {
            "label": "合伙制企业",
            "code": "partnership"
          },
          {
            "label": "独资企业",
            "code": "sole_proprietorship"
          },
          {
            "label": "特殊目的实体",
            "code": "spe"
          },
          {
            "label": "其他非自然人",
            "code": "other_non_individual"
          },
          {
            "label": "自然人",
            "code": "individual"
          }
        ]
      },
      {
        "name": "counterparty_name",
        "label": "交易对手名称",
        "type": "string",
        "source": "column",
        "meaning": "债务人全称。多边开发银行用它和规则 mdb_qualified 里的名称核对。"
      },
      {
        "name": "balance",
        "label": "债项余额",
        "type": "number",
        "unit": "CNY",
        "source": "column",
        "meaning": "这笔债项的账面本金余额，已折算为计量币种。不含利息。容易和「表外余额」「押品价值」搞混。"
      },
      {
        "name": "impairment",
        "label": "减值准备",
        "type": "number",
        "unit": "CNY",
        "source": "column",
        "meaning": "已计提的损失准备金额。表内 EAD 需要从账面余额中扣减。没有计提时填 0。"
      },
      {
        "name": "offbalance",
        "label": "是否表外",
        "type": "enum",
        "source": "column",
        "meaning": "这笔业务在资产负债表外。表外授信、未使用额度、保函填 yes。",
        "options": [
          {
            "label": "是",
            "code": "yes"
          },
          {
            "label": "否",
            "code": "no"
          }
        ]
      },
      {
        "name": "onbalance_amount",
        "label": "表内余额",
        "type": "number",
        "unit": "CNY",
        "source": "column",
        "meaning": "表外业务中已经提用、已计入表内的部分。未提用部分才是表外余额。"
      },
      {
        "name": "offbalance_amount",
        "label": "表外未提用金额",
        "type": "number",
        "unit": "CNY",
        "source": "column",
        "meaning": "授信总额度中尚未提用的部分。EAD = 表内余额 + 表外未提用金额 × CCF。"
      },
      {
        "name": "ccf",
        "label": "信用转换系数",
        "type": "number",
        "unit": "ratio",
        "source": "calc",
        "meaning": "把表外金额折算为等值表内金额的系数。20% 写成 0.2。由业务品种档位决定。「表内余额是否已计入」容易搞混。"
      },
      {
        "name": "original_maturity_months",
        "label": "原始期限",
        "type": "number",
        "unit": "month",
        "source": "calc",
        "meaning": "自合同起始日至到期日的月数，不是剩余期限。3 个月以内走短期权重。"
      },
      {
        "name": "remaining_maturity_months",
        "label": "剩余期限",
        "type": "number",
        "unit": "month",
        "source": "calc",
        "meaning": "自计量基准日至到期日的月数。容易和原始期限搞混，两者只差一个起息日。用于期限分档。"
      },
      {
        "name": "ltv",
        "label": "贷款价值比",
        "type": "number",
        "unit": "ratio",
        "source": "calc",
        "meaning": "债项余额除以押品评估价值。50% 写成 0.5。房地产分类的关键门槛。押品价值要先用计量币种。"
      },
      {
        "name": "has_property_collateral",
        "label": "是否有房地产抵押",
        "type": "enum",
        "source": "column",
        "meaning": "这笔债项是否由房地产设定抵押。对应决策图「是否有房地产抵押」。",
        "options": [
          {
            "label": "是",
            "code": "yes"
          },
          {
            "label": "否",
            "code": "no"
          }
        ]
      },
      {
