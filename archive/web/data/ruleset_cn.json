    "rules": [
      {
        "name": "cash_equivalent",
        "label": "现金及现金等价物",
        "when": {
          "all": [
            {
              "field": "instrument_type",
              "op": "eq",
              "match": "cash"
            }
          ]
        },
        "value": 0.0,
        "note": "【模拟】现金及现金等价物风险权重 0%。",
        "reference": {
          "doc": "【模拟】澳门AMCM资本充足率指引",
          "clause": "第12条",
          "version": "2026版"
        }
      },
      {
        "name": "covered_bond",
        "label": "合格资产担保债券",
        "when": {
          "all": [
            {
              "field": "instrument_type",
              "op": "eq",
              "match": "covered_bond"
            }
          ]
        },
        "children": [
          {
            "name": "covered_bond_qualified",
            "label": "合格资产担保债券",
            "when": {
              "all": [
                {
                  "field": "covered_pool_eligible",
                  "op": "eq",
                  "match": "yes"
                },
                {
                  "field": "covered_oc_ratio",
                  "op": "gte",
                  "match": 1.1
                },
                {
                  "field": "covered_disclosure_ok",
                  "op": "eq",
                  "match": "yes"
                }
              ]
            },
            "value": 0.1,
