# 模型 API Key。任何 OpenAI 兼容的大模型服务都可以，不要把真实密钥提交到 GitHub。
# 旧的 DASHSCOPE_API_KEY 名称仍然兼容；两个都填时以 MODEL_API_KEY 为准。
MODEL_API_KEY=sk-your-key

# 服务商预设：dashscope（默认）| openai | deepseek | moonshot | zhipu | siliconflow | ollama
# 以上都不合适时填 custom，再用 MODEL_BASE_URL 指向自己的兼容接口。
# MODEL_PROVIDER=dashscope

# 可选。显式接口地址，填了就以它为准，优先于 MODEL_PROVIDER 的预设。
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话、表头对应、决策树统一用这个模型；不填则用 agent/agent.json 的 runtime.model。
MODEL_NAME=qwen-plus

# 可选。表头对应单独用一个模型时才填，不填就跟 MODEL_NAME 一致。
# MAPPING_MODEL=qwen-plus

# 可选。采样参数与超时；不填时 temperature 为 0，其余用客户端默认值。
# MODEL_TEMPERATURE=0
# MODEL_MAX_TOKENS=8192
# MODEL_TIMEOUT=60

# 微信知识引擎。API Key 不要提交到 GitHub
# WEKNORA_BASE_URL=https://weknora.weixin.qq.com/api/v1
# WEKNORA_API_KEY=
# WEIXIN_APPID=
# WEIXIN_APPSECRET=

# 服务端口，默认 8766
# RWA_PORT=8766

# 对话引擎：deepagents（默认）| legacy（旧的 llm_call / tool_node 循环）
# RWA_CHAT_ENGINE=deepagents

# 总控是否挂四个 DeepAgents 子智能体：1（默认）| 0
# RWA_COORDINATOR_SUBAGENTS=1
