# 模型 API Key，不要把真实密钥提交到 GitHub
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 表头对应用的模型。右下角 AI 的模型在 agent/agent.json 的 runtime.model
# qwen-turbo | qwen-plus | qwen-max
MODEL_NAME=qwen-plus

# 可选。国内默认地址，国际区可改为 dashscope-intl
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 微信知识引擎。API Key 不要提交到 GitHub
# WEKNORA_BASE_URL=https://weknora.weixin.qq.com/api/v1
# WEKNORA_API_KEY=
# WEIXIN_APPID=
# WEIXIN_APPSECRET=

# 服务端口，默认 8766
# RWA_PORT=8766
