# 复制为 docker/app.env 后填写。docker/app.env 已在 .gitignore 中，不要提交。
# 这个文件同时给 docker compose 做端口/版本变量替换，也会注入容器环境。

RWA_VERSION=1.0.0
RWA_HTTP_PORT=8080
TZ=Asia/Shanghai

# 数据库和模型密钥也可以放在同目录的 mysql.env / model.env；
# 这两个文件不会被提交，适合由部署脚本从本地上传。
# MySQL 不在镜像里。MySQL 在宿主机时用 host.docker.internal；
# MySQL 是另一个容器或远程主机时改成对应 IP / 服务名。
# MYSQL_HOST=host.docker.internal
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=rwa

# MODEL_API_KEY=
# MODEL_NAME=qwen-plus
