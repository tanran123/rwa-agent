# 复制为 docker/deploy.env 后填写。这个文件已在 .gitignore 中，不要提交。
# 只给 docker/deploy-remote.sh 使用，不会打进镜像。

# 服务器地址，例如 root@1.2.3.4
SERVER=root@your-server

# SSH 私钥路径；使用 ssh-agent 或默认密钥时留空
SSH_KEY=

# SSH 端口，默认 22
SSH_PORT=22

# 服务器部署目录
REMOTE_DIR=/opt/rwa-agent

# 1 = 把本地 .env 和 server/.env 上传为服务器上的 model.env / mysql.env
# 0 = 不自动上传，登录服务器手工填写
UPLOAD_ENV=1
