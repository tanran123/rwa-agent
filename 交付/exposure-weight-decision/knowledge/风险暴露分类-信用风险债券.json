            { "name": "corporate_grade_2", "label": "信用质量等级2", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 2 }] }, "value": 0.5 },
            { "name": "corporate_grade_3", "label": "信用质量等级3", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 3 }] }, "value": 1.0 },
            { "name": "corporate_grade_4", "label": "信用质量等级4", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 4 }] }, "value": 1.0 },
