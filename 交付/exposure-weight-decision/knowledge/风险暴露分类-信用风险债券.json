  "extensions": [
    {
      "name": "rating_derivation_pdf16",
      "label": "未评级债权评级推导规则（第16段）",
      "description": "仅当未评级债权受偿顺位不低于参考评级债权（同顺位或优先）时，才可使用同一发行人其他债项评级推导；不得使用短期评级支持未评级的长期风险暴露。",
      "rules": [
        {
          "name": "reference_rating_seniority_check",
          "label": "参考债项受偿顺位检查",
          "when": {
            "all": [
              { "field": "issue_seniority", "op": "in", "match": ["senior", "pari_passu"] },
              { "field": "reference_issue_seniority", "op": "in", "match": ["senior", "pari_passu"] }
            ]
          },
          "action": "use_reference_rating",
          "remark": "满足条件时可按PDF第16段使用参考评级；否则标记待核实。"
        }
      ]
    },
    {
      "name": "unrated_bank_claim_exceptions",
      "label": "未评级银行债权特殊规则（第7.4节）",
      "description": "未评级银行债权须检查参考债权短期评级、主权风险权重底线。",
      "rules": [
        {
          "name": "reference_short_rating_50_or_100",
          "label": "参考债权短期评级对应50%或100%风险权重",
          "when": {
            "all": [
              { "field": "credit_quality_grade", "op": "eq", "match": "unrated" },
              { "field": "reference_short_rating_risk_weight", "op": "in", "match": [0.5, 1.0] }
            ]
          },
          "action": "set_risk_weight",
          "formula": "max(1.0, rating_derived_risk_weight_pdf16)"
        },
        {
          "name": "reference_short_rating_150",
          "label": "参考债权短期评级对应150%风险权重",
          "when": {
            "all": [
              { "field": "credit_quality_grade", "op": "eq", "match": "unrated" },
              { "field": "reference_short_rating_risk_weight", "op": "eq", "match": 1.5 }
            ]
          },
          "action": "set_risk_weight",
          "value": 1.5
        },
        {
          "name": "bank_unrated_sovereign_floor",
          "label": "未评级银行债权主权风险权重底线",
          "when": {
            "all": [
              { "field": "credit_quality_grade", "op": "eq", "match": "unrated" }
            ]
          },
          "action": "apply_floor",
          "formula": "max(calculated_risk_weight, sovereign_risk_weight)"
        }
      ]
    },
    {
      "name": "unrated_corporate_claim_exceptions",
      "label": "未评级公司债权特殊规则（第8.3节）",
      "description": "未评级公司债权须检查同一公司参考债权短期评级150%例外及主权风险权重底线。",
      "rules": [
        {
          "name": "corporate_reference_short_rating_150",
          "label": "同一公司参考债权短期评级对应150%风险权重",
          "when": {
            "all": [
              { "field": "credit_quality_grade", "op": "eq", "match": "unrated" },
              { "field": "reference_short_rating_risk_weight", "op": "eq", "match": 1.5 }
            ]
          },
          "action": "set_risk_weight",
          "value": 1.5
        },
        {
          "name": "corporate_unrated_sovereign_floor",
          "label": "未评级公司债权主权风险权重底线",
          "when": {
            "all": [
              { "field": "credit_quality_grade", "op": "eq", "match": "unrated" }
            ]
          },
          "action": "apply_floor",
          "formula": "max(calculated_risk_weight, sovereign_risk_weight)"
        }
      ]
    },
    {
      "name": "credit_risk_mitigation",
      "label": "信用风险缓释拆分计算（第10节）",
      "description": "受保护部分按抵押品或保证人风险权重处理，未受保护部分按原交易对手或发行人风险权重处理。",
      "formula": "CRWA = E_protected × RW_protected + E_unprotected × RW_unprotected",
      "rules": [
        {
          "name": "collateral_minimum_20_percent",
          "label": "抵押部分20%风险权重下限",
          "when": {
            "all": [
              { "field": "has_collateral", "op": "eq", "match": "yes" }
            ]
          },
          "action": "apply_floor",
          "formula": "max(0.2, RW_protected)",
          "exceptions": [
            {
              "name": "cash_deposit",
              "when": { "all": [{ "field": "collateral_type", "op": "eq", "match": "cash_deposit" }] }
            },
            {
              "name": "sovereign_or_pse_security_same_currency_20pct_haircut",
              "when": {
                "all": [
                  { "field": "collateral_type", "op": "in", "match": ["sovereign_security", "pse_security"] },
                  { "field": "same_currency_collateral", "op": "eq", "match": "yes" },
                  { "field": "collateral_haircut", "op": "eq", "match": 0.2 }
                ]
              }
            }
          ]
        },
        {
          "name": "guarantee_protected_portion",
          "label": "保证覆盖部分按保证人风险权重",
          "when": {
            "all": [
              { "field": "has_guarantee", "op": "eq", "match": "yes" }
            ]
          },
          "action": "set_risk_weight",
          "value": "RW_guarantor"
        },
        {
          "name": "no_double_counting_crm",
          "label": "禁止重复确认信用风险缓释",
          "when": {
            "all": [
              { "field": "specific_rating_reflects_guarantee", "op": "eq", "match": "yes" }
            ]
          },
          "action": "no_CRM_adjustment",
          "remark": "特定债项评级已反映保证或其他信用增级，不得再次确认相同保证的CRM效果。"
        },
        {
          "name": "crm_status_unknown",
          "label": "信用增级反映状态待核实",
          "when": {
            "all": [
              { "field": "specific_rating_reflects_guarantee", "op": "eq", "match": "unknown" }
            ]
          },
          "action": "pending_verification",
          "remark": "标记为待核实，不得自动重复计算缓释效果。"
        }
      ]
    }
  ],
