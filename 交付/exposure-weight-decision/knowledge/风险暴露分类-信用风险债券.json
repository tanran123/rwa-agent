{
  "name": "权重法风险暴露分类",
  "version": "2026.1-债券与同业专项更新",
  "description": "AMCM 信用风险权重法下的债券、银行同业债权、主权债权、公共部门实体债权、多边开发银行债权及相关信用风险缓释规则。核心原则：债券不能统一使用一个固定风险权重，必须先识别发行主体，再根据发行人类别、外部信用评级、债项评级、受偿顺位及相关例外规则确定适用权重。",
  "source": "AMCM PDF 第12、16、24—27、31、32、82段；表3、表5、表6、表7、表8、表9、表10",
  "fields": [
    {
      "name": "instrument_type",
      "label": "金融工具类型",
      "meaning": "区分债券、普通债权及其他金融工具。",
      "source": "业务数据",
      "options": [
        { "code": "bond", "label": "债券" },
        { "code": "ordinary_claim", "label": "普通债权" },
        { "code": "other", "label": "其他金融工具" }
      ]
    },
    {
      "name": "counterparty_type",
      "label": "发行人或交易对手类别",
      "meaning": "区分主权、中央银行、公共部门实体、多边开发银行、商业银行、公司等。",
      "source": "业务数据",
      "options": [
        { "code": "macao_government_or_amcm", "label": "澳门特别行政区政府或AMCM" },
        { "code": "foreign_sovereign", "label": "其他中央政府" },
        { "code": "central_bank", "label": "中央银行" },
        { "code": "pse", "label": "公共部门实体" },
        { "code": "mdb", "label": "多边开发银行" },
        { "code": "international_organization", "label": "国际组织" },
        { "code": "commercial_bank", "label": "商业银行" },
        { "code": "corporate", "label": "公司" }
      ]
    },
    {
      "name": "counterparty_name",
      "label": "发行人名称",
      "meaning": "用于核对发行主体及符合条件的多边开发银行名单。",
      "source": "业务数据"
    },
    {
      "name": "issuer_jurisdiction",
      "label": "发行人所属司法管辖区",
      "meaning": "用于确定发行人注册地或所属主权。",
      "source": "业务数据"
    },
    {
      "name": "issuer_rating",
      "label": "发行人外部评级",
      "meaning": "发行人层面的外部信用评级。不得自动等同于特定债项评级。",
      "source": "业务数据"
    },
    {
      "name": "issue_rating",
      "label": "特定债项外部评级",
      "meaning": "对具体债券或债项作出的评级。存在合资格的特定债项评级时，原则上优先使用。",
      "source": "业务数据"
    },
    {
      "name": "rating_agency",
      "label": "评级机构",
      "meaning": "记录评级所属的外部信用评估机构，限定为 S&P、Moody's、Fitch、R&I。",
      "source": "业务数据",
      "options": [
        { "code": "sp", "label": "S&P" },
        { "code": "moodys", "label": "Moody's" },
        { "code": "fitch", "label": "Fitch" },
        { "code": "ri", "label": "R&I" }
      ]
    },
    {
      "name": "rating_type",
      "label": "评级类型",
      "meaning": "区分短期特定债项评级、长期特定债项评级和发行人评级。",
      "source": "业务数据",
      "options": [
        { "code": "short_term_issue", "label": "短期特定债项评级" },
        { "code": "long_term_issue", "label": "长期特定债项评级" },
        { "code": "issuer", "label": "发行人评级" }
      ]
    },
    {
      "name": "credit_quality_grade",
      "label": "信用质量等级",
      "meaning": "根据适用评级映射确定的信用质量等级。",
      "source": "评级映射",
      "options": [
        { "code": 1, "label": "信用质量等级1" },
        { "code": 2, "label": "信用质量等级2" },
        { "code": 3, "label": "信用质量等级3" },
        { "code": 4, "label": "信用质量等级4" },
        { "code": 5, "label": "信用质量等级5" },
        { "code": 6, "label": "信用质量等级6" },
        { "code": "unrated", "label": "未评级" }
      ]
    },
    {
      "name": "sovereign_credit_quality_grade",
      "label": "所属主权信用质量等级",
      "meaning": "用于PSE特殊规则及未评级银行/公司债权的主权风险权重底线判断。",
      "source": "评级映射",
      "options": [
        { "code": 1, "label": "信用质量等级1" },
        { "code": 2, "label": "信用质量等级2" },
        { "code": 3, "label": "信用质量等级3" },
        { "code": 4, "label": "信用质量等级4" },
        { "code": 5, "label": "信用质量等级5" },
        { "code": 6, "label": "信用质量等级6" },
        { "code": "unrated", "label": "未评级" }
      ]
    },
    {
      "name": "issue_seniority",
      "label": "债项受偿顺位",
      "meaning": "记录债项属于优先、同顺位或次级等类别。",
      "source": "业务数据",
      "options": [
        { "code": "senior", "label": "优先" },
        { "code": "pari_passu", "label": "同顺位" },
        { "code": "subordinated", "label": "次级" }
      ]
    },
    {
      "name": "reference_issue_rating",
      "label": "参考债项评级",
      "meaning": "在本债项没有评级时，记录用于推导风险权重的其他债项评级。",
      "source": "业务数据"
    },
    {
      "name": "reference_issue_seniority",
      "label": "参考债项受偿顺位",
      "meaning": "用于判断参考债项评级能否适用于当前未评级债项。",
      "source": "业务数据",
      "options": [
        { "code": "senior", "label": "优先" },
        { "code": "pari_passu", "label": "同顺位" },
        { "code": "subordinated", "label": "次级" }
      ]
    },
    {
      "name": "reference_short_rating_risk_weight",
      "label": "参考债权短期评级对应风险权重",
      "meaning": "用于未评级银行/公司债权的例外判断。",
      "source": "评级映射"
    },
    {
      "name": "original_maturity_months",
      "label": "原始合同期限",
      "meaning": "以月为单位，判断银行债权是否符合原始期限不超过三个月的优惠权重条件。",
      "source": "业务数据",
      "unit": "月"
    },
    {
      "name": "expected_rollover",
      "label": "是否预计展期",
      "meaning": "预计展期的债权不符合原始期限不超过三个月的优惠权重条件。",
      "source": "业务数据",
      "options": [
        { "code": "yes", "label": "是" },
        { "code": "no", "label": "否" },
        { "code": "unknown", "label": "待核实" }
      ]
    },
    {
      "name": "currency",
      "label": "债权计价币种",
      "meaning": "用于判断主权及中央银行债权是否适用本币计价规则。",
      "source": "业务数据"
    },
    {
      "name": "funding_source",
      "label": "融资来源",
      "meaning": "用于判断相关主权或中央银行债权是否满足本币融资条件。",
      "source": "业务数据"
    },
    {
      "name": "specific_provision",
      "label": "特定准备金",
      "meaning": "从账面本金（含应计利息）中扣除的特定准备金额。",
      "source": "业务数据",
      "unit": "货币"
    },
    {
      "name": "principal_including_interest",
      "label": "含应计利息的本金金额",
      "meaning": "用于计算扣除特定准备金后的风险暴露金额。",
      "source": "业务数据",
      "unit": "货币"
    },
    {
      "name": "has_collateral",
      "label": "是否有抵押品",
      "meaning": "判断债权是否存在符合监管要求的抵押品。",
      "source": "业务数据",
      "options": [
        { "code": "yes", "label": "是" },
        { "code": "no", "label": "否" },
        { "code": "unknown", "label": "待核实" }
      ]
    },
    {
      "name": "has_guarantee",
      "label": "是否有保证",
      "meaning": "判断债权是否存在符合监管要求的保证。",
      "source": "业务数据",
      "options": [
        { "code": "yes", "label": "是" },
        { "code": "no", "label": "否" },
        { "code": "unknown", "label": "待核实" }
      ]
    },
    {
      "name": "collateral_type",
      "label": "抵押品类型",
      "meaning": "识别现金存款、主权证券、公共部门实体证券及其他抵押品。",
      "source": "业务数据",
      "options": [
        { "code": "cash_deposit", "label": "现金存款" },
        { "code": "sovereign_security", "label": "主权证券" },
        { "code": "pse_security", "label": "公共部门实体证券" },
        { "code": "other", "label": "其他抵押品" }
      ]
    },
    {
      "name": "collateral_haircut",
      "label": "抵押品折价比例",
      "meaning": "用于判断抵押品是否满足20%风险权重下限例外（如按20%折价处理的主权或公共部门实体证券）。",
      "source": "业务数据"
    },
    {
      "name": "guarantor_type",
      "label": "保证人类别",
      "meaning": "用于确定保证覆盖部分适用的保证人风险权重。",
      "source": "业务数据",
      "options": [
        { "code": "sovereign", "label": "主权" },
        { "code": "pse", "label": "公共部门实体" },
        { "code": "mdb", "label": "多边开发银行" },
        { "code": "commercial_bank", "label": "商业银行" },
        { "code": "corporate", "label": "公司" }
      ]
    },
    {
      "name": "same_currency_collateral",
      "label": "抵押品与债权是否同币种",
      "meaning": "用于检查特定抵押品例外的币种条件。",
      "source": "业务数据",
      "options": [
        { "code": "yes", "label": "是" },
        { "code": "no", "label": "否" },
        { "code": "unknown", "label": "待核实" }
      ]
    },
    {
      "name": "specific_rating_reflects_guarantee",
      "label": "债项评级是否已反映保证",
      "meaning": "防止对已在债项评级中反映的信用增级重复确认CRM效果。",
      "source": "业务数据",
      "options": [
        { "code": "yes", "label": "是" },
        { "code": "no", "label": "否" },
        { "code": "unknown", "label": "待核实" }
      ]
    }
  ],
  "rules": [
    {
      "name": "macao_government_or_amcm_claim",
      "label": "澳门特别行政区政府及AMCM债权",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "eq", "match": "macao_government_or_amcm" },
          { "field": "currency", "op": "eq", "match": "MOP" },
          { "field": "funding_source", "op": "eq", "match": "macao_government_or_amcm" }
        ]
      },
      "value": 0.0
    },
    {
      "name": "other_sovereign_central_bank_local_currency",
      "label": "其他中央政府及中央银行本币债权",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "in", "match": ["foreign_sovereign", "central_bank"] },
          { "field": "currency", "op": "eq", "match": "issuer_local_currency" },
          { "field": "funding_source", "op": "eq", "match": "issuer_local_currency" }
        ]
      },
      "remark": "按该司法管辖区当地监管规定的风险权重处理；无法确认币种或当地规定时不得直接适用。",
      "children": []
    },
    {
      "name": "other_sovereign_central_bank_claim",
      "label": "其他主权及中央银行债权（表3）",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "in", "match": ["foreign_sovereign", "central_bank"] }
        ]
      },
      "children": [
        { "name": "sovereign_grade_1", "label": "信用质量等级1", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 1 }] }, "value": 0.0 },
        { "name": "sovereign_grade_2", "label": "信用质量等级2", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 2 }] }, "value": 0.2 },
        { "name": "sovereign_grade_3", "label": "信用质量等级3", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 3 }] }, "value": 0.5 },
        { "name": "sovereign_grade_4", "label": "信用质量等级4", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 4 }] }, "value": 1.0 },
        { "name": "sovereign_grade_5", "label": "信用质量等级5", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 5 }] }, "value": 1.0 },
        { "name": "sovereign_grade_6", "label": "信用质量等级6", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 6 }] }, "value": 1.5 },
        { "name": "sovereign_unrated", "label": "未评级主权债权", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "unrated" }] }, "value": 1.0 }
      ]
    },
    {
      "name": "pse_claim",
      "label": "公共部门实体债权（第31段）",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "eq", "match": "pse" }
        ]
      },
      "children": [
        {
          "name": "pse_sovereign_grade_4_or_5",
          "label": "所属主权信用质量等级4或5",
          "when": { "all": [{ "field": "sovereign_credit_quality_grade", "op": "in", "match": [4, 5] }] },
          "value": 1.0
        },
        {
          "name": "pse_sovereign_grade_6",
          "label": "所属主权信用质量等级6",
          "when": { "all": [{ "field": "sovereign_credit_quality_grade", "op": "eq", "match": 6 }] },
          "value": 1.5
        },
        {
          "name": "pse_sovereign_unrated",
          "label": "所属主权未评级",
          "when": { "all": [{ "field": "sovereign_credit_quality_grade", "op": "eq", "match": "unrated" }] },
          "value": 1.0
        },
        {
          "name": "pse_usual_rule",
          "label": "PSE通常规则（所属主权风险权重高一档）",
          "when": { "all": [] },
          "remark": "按PDF第31段通常规则，结合注册地所属主权评级确定；无法确认PSE身份或所属主权时标记待核实。",
          "children": []
        }
      ]
    },
    {
      "name": "mdb_zero_percent_list",
      "label": "明确适用0%风险权重的多边开发银行及国际组织",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "in", "match": ["mdb", "international_organization"] },
          {
            "field": "counterparty_name",
            "op": "in",
            "match": [
              "BIS",
              "IMF",
              "ECB",
              "EU",
              "African Development Bank",
              "Asian Development Bank",
              "Caribbean Development Bank",
              "Council of Europe Development Bank",
              "European Bank for Reconstruction and Development",
              "European Investment Bank",
              "European Investment Fund",
              "Inter-American Development Bank",
              "Islamic Development Bank",
              "Nordic Investment Bank",
              "International Finance Facility for Immunisation",
              "World Bank Group (IBRD)",
              "World Bank Group (IFC)"
            ]
          }
        ]
      },
      "value": 0.0
    },
    {
      "name": "other_mdb_international_organization",
      "label": "其他多边开发银行及国际组织（表5）",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "in", "match": ["mdb", "international_organization"] }
        ]
      },
      "children": [
        { "name": "mdb_grade_1", "label": "信用质量等级1", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 1 }] }, "value": 0.2 },
        { "name": "mdb_grade_2", "label": "信用质量等级2", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 2 }] }, "value": 0.5 },
        { "name": "mdb_grade_3", "label": "信用质量等级3", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 3 }] }, "value": 0.5 },
        { "name": "mdb_grade_4", "label": "信用质量等级4", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 4 }] }, "value": 1.0 },
        { "name": "mdb_grade_5", "label": "信用质量等级5", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 5 }] }, "value": 1.0 },
        { "name": "mdb_grade_6", "label": "信用质量等级6", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 6 }] }, "value": 1.5 },
        { "name": "mdb_unrated", "label": "未评级", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "unrated" }] }, "value": 0.5 }
      ]
    },
    {
      "name": "bank_claim",
      "label": "银行发行的债券及银行同业债权",
      "when": {
        "all": [
          { "field": "counterparty_type", "op": "eq", "match": "commercial_bank" }
        ]
      },
      "children": [
        {
          "name": "bank_short_term_issue_rating",
          "label": "有短期特定债项评级的银行债权（表6）",
          "when": { "all": [{ "field": "rating_type", "op": "eq", "match": "short_term_issue" }] },
          "children": [
            { "name": "bank_short_grade_I", "label": "短期信用质量等级I", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "I" }] }, "value": 0.2 },
            { "name": "bank_short_grade_II", "label": "短期信用质量等级II", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "II" }] }, "value": 0.5 },
            { "name": "bank_short_grade_III", "label": "短期信用质量等级III", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "III" }] }, "value": 1.0 },
            { "name": "bank_short_grade_IV", "label": "短期信用质量等级IV", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": "IV" }] }, "value": 1.5 }
          ]
        },
        {
          "name": "bank_short_original_maturity",
          "label": "原始期限不超过三个月的其他银行债权（表7）",
          "when": {
            "all": [
              { "field": "original_maturity_months", "op": "lte", "match": 3 },
              { "field": "expected_rollover", "op": "eq", "match": "no" }
            ]
          },
          "remark": "必须检查是否存在预期展期；剩余期限不超过三个月不等同于原始期限不超过三个月。",
          "children": [
            { "name": "bank_short_maturity_grade_1", "label": "信用质量等级1", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 1 }] }, "value": 0.2 },
            { "name": "bank_short_maturity_grade_2", "label": "信用质量等级2", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 2 }] }, "value": 0.2 },
            { "name": "bank_short_maturity_grade_3", "label": "信用质量等级3", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 3 }] }, "value": 0.2 },
            { "name": "bank_short_maturity_grade_4", "label": "信用质量等级4", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 4 }] }, "value": 0.5 },
            { "name": "bank_short_maturity_grade_5", "label": "信用质量等级5", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 5 }] }, "value": 0.5 },
            { "name": "bank_short_maturity_grade_6", "label": "信用质量等级6", "when": { "all": [{ "field": "credit_quality_grade", "op": "eq", "match": 6 }] }, "value": 1.5 },
