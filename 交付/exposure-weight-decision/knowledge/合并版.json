{
  "name": "mo_sa_exposure_class",
  "title": "澳门信用风险风险暴露分类",
  "remark": "按澳门信用风险填报规则（P13-P37）编写。底层公式：CRWA = 本金(经CRM调整) × 风险权重。本金按澳门会计准则账面价值(含应计利息)并扣除特定准备(Specific Provision)。表外只算未提取部分，已提取进表内；衍生品盯市价值已记表内时须从表内剔除后再算CRWA。应计利息随所属债权同权重，无法归类放其他未逾期表内项目(100%)。本文件只写 rules 一套，未写 layers/if_yes/then。",
  "fields": [
    {
      "name": "exposure_side",
      "label": "填报位置",
      "meaning": "这笔暴露填报在 Part I 表内、Part II 表外还是 Part III 衍生品。表外承诺只有未提取部分填表外，已提取部分必须填表内。衍生品若盯市价值已作为应收/应付记在表内，须从表内剔除后再算衍生品CRWA。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "表内", "code": "on_balance" },
        { "label": "表外", "code": "off_balance" },
        { "label": "衍生品", "code": "derivative" }
      ]
    },
    {
      "name": "exposure_class",
      "label": "风险暴露类别",
      "meaning": "这笔暴露属于哪一类：同业债权(Claims on banks)、债券/债权类资产(Debt securities)、零售组合、住宅抵押、逾期贷款、现金及等价物、其他未逾期表内资产、衍生品交易对手信用风险、回购交易。表头可能叫业务品种、资产类型。",
      "source": "column",
      "type": "enum",
      "extensible": true,
      "options": [
        { "label": "同业债权", "code": "claim_on_bank" },
        { "label": "债券/债权类资产", "code": "debt_security" },
        { "label": "零售组合", "code": "retail" },
        { "label": "住宅抵押", "code": "residential_mortgage" },
        { "label": "逾期贷款", "code": "past_due_loan" },
        { "label": "现金及等价物", "code": "cash_equivalent" },
        { "label": "其他未逾期表内资产", "code": "other_on_balance" },
        { "label": "衍生品交易对手信用风险", "code": "ccr_derivative" },
        { "label": "回购交易", "code": "repo_style" }
      ]
    },
    {
      "name": "counterparty_type",
      "label": "交易对手类型",
      "meaning": "债务人/发行人属于哪一类主体。澳门政府/AMCM 填 mo_government；其他主权或央行填 foreign_sovereign；公共部门实体填 pse；多边开发银行填 mdb；商业银行(含澳门认可机构)填 commercial_bank；公司填 corporate；自然人填 individual。",
      "source": "column",
      "type": "enum",
      "extensible": true,
      "options": [
        { "label": "澳门政府或AMCM", "code": "mo_government" },
        { "label": "其他主权国家或央行", "code": "foreign_sovereign" },
        { "label": "公共部门实体", "code": "pse" },
        { "label": "多边开发银行", "code": "mdb" },
        { "label": "商业银行", "code": "commercial_bank" },
        { "label": "公司", "code": "corporate" },
        { "label": "自然人", "code": "individual" }
      ]
    },
    {
      "name": "is_mop_funding",
      "label": "是否以MOP计价融资",
      "meaning": "对澳门政府/AMCM 的债权，是否以澳门元(MOP)计价融资。是才适用 0%。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "issuer_rating",
      "label": "外部评级",
      "meaning": "外部评级符号，如 AAA、AA-、B-，没有评级时用 unrated。用于同业债权、主权、PSE、MDB、公司债的评级分档。注意多重评级要按 multiple_assessments 规则取值，不得挑樱桃。",
      "source": "column",
      "type": "enum",
      "extensible": true,
      "options": [
        { "code": "AAA", "label": "AAA" },
        { "code": "AA+", "label": "AA+" },
        { "code": "AA", "label": "AA" },
        { "code": "AA-", "label": "AA-" },
        { "code": "A+", "label": "A+" },
        { "code": "A", "label": "A" },
        { "code": "A-", "label": "A-" },
        { "code": "BBB+", "label": "BBB+" },
        { "code": "BBB", "label": "BBB" },
        { "code": "BBB-", "label": "BBB-" },
        { "code": "BB+", "label": "BB+" },
        { "code": "BB", "label": "BB" },
        { "code": "BB-", "label": "BB-" },
        { "code": "B+", "label": "B+" },
        { "code": "B", "label": "B" },
        { "code": "B-", "label": "B-" },
        { "code": "CCC", "label": "CCC" },
        { "code": "CC", "label": "CC" },
        { "code": "C", "label": "C" },
        { "code": "D", "label": "D" },
        { "code": "unrated", "label": "unrated" }
      ]
    },
    {
      "name": "specific_short_rating_weight",
      "label": "该笔债权自身短期特定评级对应权重",
      "meaning": "同业债权若自身有短期特定评级，按表6 取 20%/50%/100%/150%，写成比值 0.2/0.5/1/1.5。没有短期特定评级就留空。",
      "source": "column",
      "type": "number",
      "unit": "ratio"
    },
    {
      "name": "original_maturity_months",
      "label": "原始期限",
      "meaning": "这笔债权的原始期限，单位月。3 个月以内走短期权重。表里是起息日和到期日时在 how 里换成月数。",
      "source": "column",
      "type": "number",
      "unit": "month"
    },
    {
      "name": "bank_peer_weight",
      "label": "同一银行其他已评级债权最高权重",
      "meaning": "同一家商业银行其他已评级债权里已经算出的最高风险权重(按表6/表7/表8推导)。由计算写入。没有其他已评级债权就不要填。不要从 Excel 对。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "derived_bank_weight",
      "label": "同业债权按一般信用质量等级已得权重",
      "meaning": "这笔未评级同业债权按一般信用质量等级(表7/表8)先得出的风险权重。用于与 100% 取较大值。由计算写入。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "sovereign_home_weight",
      "label": "注册地主权国家风险权重",
      "meaning": "该银行注册地所在主权国家的风险权重，用作未评级同业债权和未评级公司债权的天花板。由计算写入。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "is_residential_mortgage",
      "label": "是否住宅抵押",
      "meaning": "这笔是否有住宅房地产抵押。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "overdue_days",
      "label": "逾期天数",
      "meaning": "逾期天数。超过 90 天归逾期贷款；住宅抵押未逾期或不超过 90 天走 50%。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "provision_ratio",
      "label": "特定准备占账面价值比例",
      "meaning": "特定准备(Specific Provision)占账面价值的比例。20% 写成 0.2。逾期贷款特定准备低于 20% 走 150%，不低于 20% 走 100%。",
      "source": "column",
      "type": "number",
      "unit": "ratio"
    },
    {
      "name": "prior_weight_150",
      "label": "归为逾期前是否已适用150%",
      "meaning": "这笔贷款在被归为逾期之前适用的风险权重是否为 150%。是则即使后来变成逾期贷款，依然是 150%。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "retail_qualified",
      "label": "是否满足零售组合条件",
      "meaning": "是否满足分散、单户风险暴露不超过 1000 万等零售组合条件。证券(股票/债券)、住宅抵押贷款、逾期贷款被明确排除在零售组合之外。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "cash_kind",
      "label": "现金及等价物种类",
      "meaning": "现金/政府凭证/金条为 cash_gold；托收中现金为 collection_cash；无金条负债支撑的金条为 unbacked_gold。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "现金/政府凭证/金条", "code": "cash_gold" },
        { "label": "托收中现金", "code": "collection_cash" },
        { "label": "无金条负债支撑的金条", "code": "unbacked_gold" }
      ]
    },
    {
      "name": "is_unrated_reference_150",
      "label": "公司是否有参考短期评级为150%",
      "meaning": "该公司的任何参考短期评级(表9)是否为 150%。是则该公司所有未评级债权强制定为 150%。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "assessment_count",
      "label": "评级个数",
      "meaning": "这一笔适用的外部评级个数。由计算写入。对不上数字权重的评级不计入个数。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "covered_amount",
      "label": "被覆盖金额",
      "meaning": "抵押或担保保护得住的那一部分本金。货币错配时先按抵押品价值折扣后再填。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "uncovered_amount",
      "label": "未覆盖金额",
      "meaning": "没有抵押或担保保护的那一部分本金。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "protection_weight",
      "label": "保护方权重",
      "meaning": "合格抵押品或合格担保人自己的风险权重，用比值。20% 写成 0.2。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "debtor_weight",
      "label": "原债务人权重",
      "meaning": "原债务人已经确定的风险权重。拆分时原样使用，不在这里改。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "same_currency",
      "label": "抵押品与债权是否同币种",
      "meaning": "抵押品币种和债权币种相同填 yes，不同填 no。MOP/HKD/USD 之间以及 RMB 与它们之间允许错配，但错配时抵押品价值须乘 50% Haircut。期限不允许错配。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "collateral_kind",
      "label": "抵押品类型",
      "meaning": "现金存款(含存单)、极优质主权债(信用等级4及以上主权债或PSE债)、或其他。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "现金存款", "code": "cash_deposit" },
        { "label": "极优质主权债", "code": "sovereign_debt" },
        { "label": "其他", "code": "other" }
      ]
    },
    {
      "name": "sovereign_market_haircut",
      "label": "主权债市值折扣",
      "meaning": "极优质主权债用作抵押时，市值已经按八折计入则填 0.8。不是主权债就不要填。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "crm_tool_count",
      "label": "CRM工具个数",
      "meaning": "这笔暴露上适用的信用风险缓释工具个数。一债多保时按每种工具拆分暴露分别计算 CRWA。由计算写入。",
      "source": "calc",
      "type": "number"
    },
    {
      "name": "current_exposure",
      "label": "当前暴露(盯市成本)",
      "meaning": "衍生品的当前暴露，即盯市成本，只取大于 0 的部分。若该盯市价值已作为应收/应付记在表内，须先从表内剔除。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "notional_principal",
      "label": "名义本金",
      "meaning": "衍生品的名义本金，用于计算潜在暴露。",
      "source": "column",
      "type": "number"
    },
    {
      "name": "derivative_kind",
      "label": "衍生品类型",
      "meaning": "利率合约为 interest_rate；外汇/黄金为 fx_gold；单一币种浮动/浮动利率互换为 float_float_swap(潜在暴露为 0)。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "利率合约", "code": "interest_rate" },
        { "label": "外汇/黄金", "code": "fx_gold" },
        { "label": "单一币种浮动/浮动利率互换", "code": "float_float_swap" }
      ]
    },
    {
      "name": "derivative_maturity_band",
      "label": "衍生品期限档",
      "meaning": "利率合约与外汇/黄金的期限档：不超过1年为 le_1y；1至5年为 1_5y；超过5年为 gt_5y。用于取 CCF。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "不超过1年", "code": "le_1y" },
        { "label": "1至5年", "code": "1_5y" },
        { "label": "超过5年", "code": "gt_5y" }
      ]
    },
    {
      "name": "has_qualifying_netting",
      "label": "是否有合格双边净额结算协议",
      "meaning": "是否有合格的双边净额结算协议。有则 Anet = 0.4 × Agross + 0.6 × NGR × Agross。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    },
    {
      "name": "repo_role",
      "label": "回购交易角色",
      "meaning": "债券借出方为 lender；资金借出方为 cash_lender。债券借出方债券留在表内按债券自身权重；资金借出方视为以债券为抵押的贷款，全额抵押时债券权重替代交易对手权重。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "债券借出方", "code": "lender" },
        { "label": "资金借出方", "code": "cash_lender" }
      ]
    },
    {
      "name": "repo_fully_collateralized",
      "label": "回购是否全额抵押",
      "meaning": "回购交易是否全额抵押。资金借出方全额抵押时，用债券权重替代交易对手权重。",
      "source": "column",
      "type": "enum",
      "options": [
        { "label": "是", "code": "yes" },
        { "label": "否", "code": "no" }
      ]
    }
  ],
  "rules": [
    {
      "name": "derivative_ccr",
      "label": "衍生品交易对手信用风险(CCR)",
      "note": "P24-P27。CEA = 当前暴露(盯市成本>0) + 潜在暴露(名义本金 × CCF)。CCF 按表14：利率合约≤1年0.0%、1-5年0.5%、>5年1.5%；外汇/黄金≤1年1.0%、1-5年5.0%、>5年7.5%；单一币种浮动/浮动利率互换潜在暴露为0。有合格净额协议时 Anet = 0.4×Agross + 0.6×NGR×Agross。最终 CRWA = (净当前暴露 + Anet - 特定准备) × 交易对手权重。若盯市价值已记表内，须先剔除。",
      "when": {
        "all": [
          { "field": "exposure_side", "op": "eq", "match": "derivative" }
        ]
      },
      "fields": [
        {
          "name": "ccf",
          "label": "信用转换系数CCF",
          "meaning": "潜在暴露 = 名义本金 × CCF。利率合约≤1年0.0、1-5年0.005、>5年0.015；外汇/黄金≤1年0.01、1-5年0.05、>5年0.075。由计算写入。",
          "source": "calc",
          "type": "number",
          "unit": "ratio"
        },
        {
          "name": "potential_exposure",
          "label": "潜在暴露",
          "meaning": "名义本金 × CCF。由计算写入。",
          "source": "calc",
          "type": "number"
        }
      ],
      "children": [
        {
          "name": "ccr_float_float",
          "label": "单一币种浮动/浮动利率互换",
          "note": "潜在暴露为 0。",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "float_float_swap" }
            ]
          }
        },
        {
          "name": "ccr_interest_rate_le_1y",
          "label": "利率合约，不超过1年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "interest_rate" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "le_1y" }
            ]
          }
        },
        {
          "name": "ccr_interest_rate_1_5y",
          "label": "利率合约，1至5年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "interest_rate" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "1_5y" }
            ]
          }
        },
        {
          "name": "ccr_interest_rate_gt_5y",
          "label": "利率合约，超过5年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "interest_rate" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "gt_5y" }
            ]
          }
        },
        {
          "name": "ccr_fx_gold_le_1y",
          "label": "外汇/黄金，不超过1年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "fx_gold" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "le_1y" }
            ]
          }
        },
        {
          "name": "ccr_fx_gold_1_5y",
          "label": "外汇/黄金，1至5年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "fx_gold" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "1_5y" }
            ]
          }
        },
        {
          "name": "ccr_fx_gold_gt_5y",
          "label": "外汇/黄金，超过5年",
          "when": {
            "all": [
              { "field": "derivative_kind", "op": "eq", "match": "fx_gold" },
              { "field": "derivative_maturity_band", "op": "eq", "match": "gt_5y" }
            ]
          }
        }
      ]
    },
    {
      "name": "repo_style",
      "label": "回购交易",
      "note": "P36-P37 示例4。采用经济实质法填报在表内。债券借出方债券留在表内，按债券自身权重(如 A 级主权债 20%)计算 CRWA；资金借出方视为以债券为抵押的贷款，全额抵押时债券权重(20%)替代交易对手权重(50%)。",
      "when": {
        "all": [
          { "field": "exposure_class", "op": "eq", "match": "repo_style" }
        ]
      },
      "children": [
        {
          "name": "repo_lender",
