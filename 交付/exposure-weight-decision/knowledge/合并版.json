    {
      "name": "other_on_balance",
      "label": "其他未逾期表内项目",
      "note": "P22 第49段、P14 第8段。无法归类的表内资产(含无法归类的应计利息)走 100%。",
      "when": {
        "all": [
          { "field": "exposure_class", "op": "eq", "match": "other_on_balance" }
        ]
      },
      "value": 1
    },
    {
      "name": "multiple_assessments",
      "label": "多重评级取值",
      "note": "P16 第21-23段。1个评级直接用；2个评级(权重不同)取较高权重；≥3个评级(权重不同)取最低的两个评级，再在这两个中取较高权重。严禁挑樱桃。没有when，分类不会停在这一条。applies_to 只放 issuer_rating，商业银行的A+/A/B/C不写在这里。",
      "applies_to": ["issuer_rating"],
      "pick": [
        {
          "when": { "field": "assessment_count", "op": "eq", "match": 1 },
          "use": "only"
        },
        {
          "when": { "field": "assessment_count", "op": "eq", "match": 2 },
          "use": "higher_weight"
        },
        {
          "when": { "field": "assessment_count", "op": "gte", "match": 3 },
          "use": "higher_of_two_lowest_weights"
        }
      ],
      "children": [
        {
          "name": "multiple_assessments_one",
          "label": "只有1个评级",
          "note": "用该评级对应的权重。",
          "when": {
            "all": [
              { "field": "assessment_count", "op": "eq", "match": 1 }
            ]
          }
        },
        {
          "name": "multiple_assessments_two",
          "label": "2个评级且权重不同",
          "note": "用较高的风险权重。权重相同就用这个权重。",
          "when": {
            "all": [
              { "field": "assessment_count", "op": "eq", "match": 2 }
            ]
          }
        },
        {
          "name": "multiple_assessments_many",
          "label": "3个及以上评级且权重不同",
          "note": "先取权重最低的两个，再用这两个中较高的权重。不得为了降低资本要求改选评级。",
          "when": {
            "all": [
              { "field": "assessment_count", "op": "gte", "match": 3 }
            ]
          }
        }
      ]
    },
    {
      "name": "crm_split",
      "label": "信用风险缓释拆分",
      "note": "P28-P31。合格抵押品：存放在该行的现金(含存单)、黄金、信用等级4及以上的主权债、信用等级4及以上的PSE债。合格担保人：主权实体、PSE、银行，以及风险权重≤20%且低于原债务人风险权重的其他实体。部分覆盖拆分：被覆盖部分适用抵押品/担保人权重，下限20%；未覆盖部分适用原债务人权重。0%特权：同币种(或允许错配的币种)，抵押品为现金存款，或为0%主权/PSE债(且市值已折扣20%)，被覆盖部分可降为0%。错配规则：期限绝对不允许错配；货币允许MOP/HKD/USD之间以及RMB与它们之间错配，错配时抵押品价值施加50% Haircut。一债多保：按每种工具拆分暴露分别计算CRWA。覆盖金额、未覆盖金额、保护方权重、币种是否相同、抵押品类型缺任何一项时不拆分。",
      "formula": "covered_amount * protection_weight_used + uncovered_amount * debtor_weight",
      "covered": {
        "floor": 0.2,
        "note": "未触发0%豁免时，被覆盖部分权重取保护方权重和0.2中的较大者。"
      },
      "fields": [
        {
          "name": "covered_amount",
          "label": "被覆盖金额",
          "meaning": "抵押或担保保护得住的那一部分本金。货币错配时先按抵押品价值折扣后再填。",
          "source": "column",
          "type": "number"
        },
        {
          "name": "uncovered_amount",
          "label": "未覆盖金额",
          "meaning": "没有抵押或担保保护的那一部分本金。",
          "source": "column",
          "type": "number"
        },
        {
          "name": "protection_weight",
          "label": "保护方权重",
          "meaning": "合格抵押品或合格担保人自己的风险权重，用比值。20% 写成 0.2。",
          "source": "column",
          "type": "number"
        },
        {
          "name": "debtor_weight",
          "label": "原债务人权重",
          "meaning": "原债务人已经确定的风险权重。拆分时原样使用，不在这里改。",
          "source": "calc",
          "type": "number"
        },
        {
          "name": "same_currency",
          "label": "抵押品与债权是否同币种",
          "meaning": "抵押品币种和债权币种相同填 yes，不同填 no。MOP/HKD/USD 之间以及 RMB 与它们之间允许错配，但错配时抵押品价值须乘50% Haircut。期限不允许错配。",
          "source": "column",
          "type": "enum",
          "options": [
            { "label": "是", "code": "yes" },
            { "label": "否", "code": "no" }
          ]
        },
        {
          "name": "collateral_kind",
          "label": "抵押品类型",
          "meaning": "现金存款(含存单)、极优质主权债(信用等级4及以上的主权债或PSE债)、或其他。",
          "source": "column",
          "type": "enum",
          "options": [
            { "label": "现金存款", "code": "cash_deposit" },
            { "label": "极优质主权债", "code": "sovereign_debt" },
            { "label": "其他", "code": "other" }
          ]
        },
        {
          "name": "sovereign_market_haircut",
          "label": "主权债市值折扣",
          "meaning": "极优质主权债用作抵押时，市值已经按八折计入则填0.8。不是主权债就不要填。",
          "source": "column",
          "type": "number"
        }
      ],
      "children": [
        {
          "name": "crm_currency_mismatch",
          "label": "货币错配折扣",
          "note": "P29 第78段。抵押品与债权币种不同时，抵押品价值乘0.5，再用折后价值确定被覆盖金额。",
          "when": {
            "all": [
              { "field": "same_currency", "op": "eq", "match": "no" }
            ]
          },
          "collateral_value_factor": 0.5
        },
        {
          "name": "crm_zero_exemption",
          "label": "被覆盖部分0%豁免",
          "note": "P30 第82段。同币种，且抵押品是现金存款或极优质主权债。主权债还要市值已经按0.8计入。满足时被覆盖部分权重用0，不再套0.2下限。现金存款不要求这个八折。",
          "when": {
            "all": [
              { "field": "same_currency", "op": "eq", "match": "yes" },
              { "field": "collateral_kind", "op": "in", "match": ["cash_deposit", "sovereign_debt"] }
            ]
          },
          "if_collateral_kind": {
            "match": "sovereign_debt",
            "requires": { "field": "sovereign_market_haircut", "op": "eq", "match": 0.8 }
          },
          "value": 0
        },
        {
          "name": "crm_multiple_tools",
          "label": "一债多保",
          "note": "P31 第87段。一笔暴露有多个CRM时，按每种工具拆分暴露，分别计算CRWA。",
          "when": {
            "all": [
              { "field": "crm_tool_count", "op": "gte", "match": 2 }
            ]
          }
        }
      ]
    }
  ],
  "otherwise": {
    "name": "unclassified",
    "label": "未归类"
  },
