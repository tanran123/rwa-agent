{
  "name": "表外 EAD 计算配置",
  "side": "off",
  "version": "MO-SA-2026.1",
  "products": [
    {
      "code": "off_bs",
      "rules": [
        {
          "id": "EAD-OFF-001",
          "name": "表外授信类 EAD（一年以内贷款承诺）",
          "inputs": [
            "onbalance_amount",
            "offbalance_amount"
          ],
          "formula": "EAD = 表内已提用金额 + 表外未提用金额 × CCF",
          "steps": [
            "取已提用并计入表内的金额 onbalance_amount",
            "取表外未提用金额 offbalance_amount",
            "未提用金额 × 20%",
            "两项相加，保留 2 位小数"
          ],
          "condition": "原始期限一年以内的贷款承诺",
          "precision": 2,
          "rounding": "四舍五入",
          "resultField": "off_balance_ead",
          "clause": "CL-MO-064",
          "status": "published",
          "ccf": 0.2,
          "params": [
            {
              "name": "信用转换系数 CCF",
              "value": "0.2",
              "basis": "一年以内贷款承诺档位"
            }
          ]
        },
        {
          "id": "EAD-OFF-002",
          "name": "表外授信类 EAD（一年以上贷款承诺）",
          "inputs": [
            "onbalance_amount",
            "offbalance_amount"
          ],
          "formula": "EAD = 表内已提用金额 + 表外未提用金额 × CCF",
          "steps": [
            "取已提用金额 onbalance_amount",
            "取表外未提用金额 offbalance_amount",
            "未提用金额 × 50%",
            "两项相加，保留 2 位小数"
          ],
          "condition": "原始期限一年以上的贷款承诺",
          "precision": 2,
          "rounding": "四舍五入",
          "resultField": "off_balance_ead",
          "clause": "CL-MO-064",
          "status": "published",
          "ccf": 0.5,
          "params": [
            {
              "name": "信用转换系数 CCF",
              "value": "0.5",
              "basis": "一年以上贷款承诺档位"
            }
          ]
        },
        {
          "id": "EAD-OFF-003",
          "name": "表外授信类 EAD（信用证）",
          "inputs": [
            "offbalance_amount"
          ],
          "formula": "EAD = 表外未提用金额 × CCF",
          "steps": [
            "取信用证的未使用金额 offbalance_amount",
            "乘以 20%"
          ],
          "condition": "跟单信用证及备用信用证",
          "precision": 2,
          "rounding": "四舍五入",
          "resultField": "off_balance_ead",
          "clause": "CL-MO-064",
          "status": "draft",
          "ccf": 0.2,
          "params": [
            {
              "name": "信用转换系数 CCF",
              "value": "0.2",
              "basis": "信用证档位"
            }
          ]
        }
      ]
    }
  ]
}
