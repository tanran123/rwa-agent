{
  "name": "表内 EAD 计算配置",
  "side": "on",
  "version": "MO-SA-2026.1",
  "products": [
    {
      "code": "corp_loan",
      "rules": [
        {
          "id": "EAD-ON-001",
          "name": "表内债权类 EAD",
          "inputs": [
            "balance"
          ],
          "formula": "EAD = 账面余额",
          "steps": [
            "取该笔债项的账面本金余额 balance",
            "按精度 2 位小数保留，舍入方式为四舍五入"
          ],
          "condition": "适用于所有表内债权类业务",
          "precision": 2,
          "rounding": "四舍五入",
          "resultField": "on_balance_ead",
          "clause": "CL-MO-060",
          "status": "published",
          "params": []
        }
      ]
    },
